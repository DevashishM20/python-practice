class node:
    def __init__(self,data):
        self.data=data
        self.prev=None
        self.next=None
class DoublyLL:
    def __init__(self):
        self.head=None
    def InsertAtBeg(self,value):
        nn=node(value)
        if self.head==None:
            self.head=nn
            return
        else:
            nn.next=self.head
            self.head.prev=nn
            self.head=nn
    def DeleteLatNode(self):
        if self.head==None:
            print("Linked List is empty")
            return
        if self.head.next==None:
            self.head=None
            return
        else:
            nn=self.head
            while nn.next!=None:
                nn=nn.next
        nn.prev.next = None
    def printLL(self):
        t1=self.head
        while t1.next!=None:
            print(t1.data)
            t1=t1.next
        print(t1.data)
a=DoublyLL()
