class node:
    def __init__(self,value,next=None):
        self.value=value
        self.next=next
class SinglyLinkList:
    def __init__(self,head=None):
        self.head=head
    def InsertAtEnd(self,value):
        t1=self.head
        prev=t1
        if t1==value:
            self.head=t1.next
            break
        else:
            prev=t1
            t1=t1.next
    def display(self):
        t1=self.head
        while t1.next !=None:
            print(t1.value)
            t1=t1.next
        print(t1.value)
a=SinglyLinkList()
a.InsertAtEnd(10)
a.display()