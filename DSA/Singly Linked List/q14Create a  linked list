class node:
    def __init__(self,info,next=None):
        self.info=info
        self.next=next

class SinglyLL:
    def __init__(self,head=None):
        self.head=head
    def add(self,value):
        temp=node(value)
        if self.head==None:
            self.head=temp
        else:
            t1=self.head
            while t1.next!=None:
                t1=t1.next
            t1.next=temp
    def display(self):
        t1=self.head
        while t1!=None:
            print(t1.info)
            t1=t1.next
a=SinglyLL()
a.add(10)
a.add(20)
a.add(30)
a.display()