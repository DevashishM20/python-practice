class node:
    def __init__(self,value,next=None):
        self.value=value
        self.next=next
class SinglyLinkList:
    def __init__(self,head=None):
        self.head=head
    def InsertAtBeg(self,value):
        temp=node(value)
        temp.next=self.head
        self.head=temp
    def display(self):
        t1=self.head
        while t1.next != None:
            print(t1.value)
            t1=t1.next
        print(t1.value)
a=SinglyLinkList()
a.InsertAtBeg(5)
a.display()